# ==============================================================================
# .gitignore — modern web project (Node / Next.js / React / build tooling)
# Reusable template: sections apply to any JS/TS web project.
# ==============================================================================

# --- Dependencies -------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# --- Build output -------------------------------------------------------------
.next/
out/
build/
dist/
.turbo/
.vercel/
.netlify/
.cache/
*.tsbuildinfo
next-env.d.ts

# --- Environment & secrets ----------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets*.yml
credentials*.json

# --- Logs ---------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
firebase-debug.log*

# --- Testing & coverage -------------------------------------------------------
coverage/
*.lcov
.nyc_output/
playwright-report/
test-results/

# --- IDE / editor -------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~
*.orig

# --- OS files -----------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Databases (local dev) ----------------------------------------------------
*.db
*.sqlite
*.sqlite3
drizzle/migrations/

# --- Framework / tool specific ------------------------------------------------
.firebase/
firebase-tools/
.eslintcache
.stylelintcache
.parcel-cache/
storybook-static/

# --- Temporary ----------------------------------------------------------------
tmp/
temp/
*.tmp
